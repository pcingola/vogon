{
  "description": "VOGON: the configuration at session start, record checks after a write under the records directory, and refusals of a commit naming an unknown id, a transition into an approved state, and a test agent's read outside the records and the tests.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vogon hook session-start"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vogon hook post-write"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vogon hook commit"}
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vogon hook transition"}
        ]
      },
      {
        "matcher": "^(Read|Grep|Glob|LS|NotebookRead|NotebookEdit|Edit|MultiEdit|Write|Bash|PowerShell)$|^mcp__",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vogon hook test-read"}
        ]
      }
    ]
  }
}
